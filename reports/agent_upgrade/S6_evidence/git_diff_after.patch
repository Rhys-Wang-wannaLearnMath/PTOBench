+def _call_prefill_comparator(
+    comparator,
+    actual,
+    expected,
+    *,
+    inputs,
+    actual_outputs,
+    expected_outputs,
+):
+    return comparator(
+        actual,
+        expected,
+        actual_outputs=actual_outputs,
+        expected_outputs=expected_outputs,
+        inputs=inputs,
