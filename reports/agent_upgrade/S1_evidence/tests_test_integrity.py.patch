+    def test_corrupt_missing_and_linked_recovery_sources_fail_before_repair(self):
+        manifest = self.capture()
+        backup = self.protection / manifest["roots"]["assets"]["entries"]["a.txt"]["backup"]
+        original = backup.read_bytes()
+        (self.assets / "a.txt").write_text("changed")
+        sentinel = self.root / "sentinel"
+        sentinel.write_text("outside")
+        for corruption in ("bytes", "missing", "link"):
+            with self.subTest(corruption=corruption):
+                if backup.exists() or backup.is_symlink():
+                    backup.unlink()
+                if corruption == "bytes":
+                    backup.write_bytes(b"broken")
+                elif corruption == "link":
+                    backup.symlink_to(sentinel)
+                with self.assertRaises(integrity.InfrastructureError) as failure:
+                    integrity.check_and_restore(self.protection)
+                self.assertIn("assets/a.txt", failure.exception.report.unrecoverable_paths)
+                self.assertEqual((self.assets / "a.txt").read_text(), "changed")
+                self.assertEqual(sentinel.read_text(), "outside")
+        backup.unlink()
+        backup.write_bytes(original)
+        integrity.check_and_restore(self.protection)
+        self.assertEqual((self.assets / "a.txt").read_bytes(), b"original a")
+
+    def test_corrupt_manifest_and_invalid_paths_are_not_rebaselined(self):
+        manifest = self.capture()
+        manifest_path = self.protection / "manifest.json"
+        original = manifest_path.read_bytes()
+        invalid = []
+        bad = json.loads(original)
+        bad["roots"]["assets"]["entries"]["../escape"] = {"kind": "directory", "mode": 0o755}
+        invalid.append(json.dumps(bad).encode())
+        bad = json.loads(original)
+        bad["roots"]["assets"]["path"] = "/"
+        invalid.append(json.dumps(bad).encode())
+        bad = json.loads(original)
+        bad["roots"]["assets"]["entries"]["a.txt"]["backup"] = "../escape"
+        invalid.append(json.dumps(bad).encode())
+        for data in [b"not JSON", b"[]", *invalid]:
+            with self.subTest(data=data):
+                manifest_path.write_bytes(data)
+                with self.assertRaises(integrity.InfrastructureError):
+                    integrity.check_and_restore(self.protection)
+                self.assertEqual(manifest_path.read_bytes(), data)
+                self.assertEqual((self.assets / "a.txt").read_bytes(), b"original a")
+        manifest_path.write_bytes(original)
+        with self.assertRaises(integrity.InfrastructureError):
+            self.capture()
