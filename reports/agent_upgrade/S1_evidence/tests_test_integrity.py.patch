+    def test_permissions_cache_exclusions_and_expected_absence(self):
+        records = self.records()
+        original_mode = (self.assets / "a.txt").stat().st_mode & 0o777
+        self.capture(**records)
+        (self.assets / "__pycache__").mkdir()
+        (self.assets / "__pycache__/ignored.pyc").write_bytes(b"cache")
+        (self.assets / "nested/cache.pyo").write_bytes(b"cache")
+        self.assertTrue(integrity.check_only(self.protection).passed)
+        (self.root / "final_result.json").write_text("forged")
+        (self.assets / "a.txt").chmod(0o777)
+        integrity.check_and_restore(self.protection)
+        self.assertFalse((self.root / "final_result.json").exists())
+        self.assertEqual((self.assets / "a.txt").stat().st_mode & 0o777, original_mode)
+        self.assertTrue((self.assets / "__pycache__/ignored.pyc").exists())
+        integrity.commit_records(self.protection, {"final": b'{"status":"completed"}'})
+        (self.root / "final_result.json").unlink()
+        integrity.check_and_restore(self.protection, "records")
+        self.assertEqual((self.root / "final_result.json").read_bytes(), b'{"status":"completed"}')
