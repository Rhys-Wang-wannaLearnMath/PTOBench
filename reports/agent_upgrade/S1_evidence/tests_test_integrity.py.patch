+from __future__ import annotations
+
+import json
+import multiprocessing
+import os
+from pathlib import Path
+import shutil
+import sys
+import tempfile
+import unittest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+import integrity
+
+
+def _commit_worker(protection, value, ready=None):
+    if ready is not None:
+        ready.wait(5)
+    integrity.commit_records(Path(protection), {
+        "budget": json.dumps({"used": value}).encode(),
+        "events": json.dumps({"seq": value}).encode(),
+    })
+
+
+def _crash_commit_worker(protection, point):
+    protection = Path(protection)
+    write = integrity._write_manifest
+    replace = integrity._replace_record
+    atomic = integrity.file_tree.atomic_bytes
+    count = 0
+
+    def interrupted_write(root, manifest):
+        if point == "before_manifest":
+            os._exit(23)
+        write(root, manifest)
+        if point == "after_manifest":
+            os._exit(23)
+
+    def interrupted_replace(*args):
+        nonlocal count
+        replace(*args)
+        count += 1
+        if point == "after_first_record" and count == 1:
+            os._exit(23)
+        if point == "after_last_record" and count == 2:
+            os._exit(23)
+
+    def interrupted_backup(path, *args, **kwargs):
+        if point == "before_backup" and Path(path).parent.name == "backups":
+            os._exit(23)
+        atomic(path, *args, **kwargs)
+        if point == "after_backup" and Path(path).parent.name == "backups":
+            os._exit(23)
+
+    integrity._write_manifest = interrupted_write
+    integrity._replace_record = interrupted_replace
+    integrity.file_tree.atomic_bytes = interrupted_backup
+    _commit_worker(protection, 1)
+
+
+class FileIntegrityTest(unittest.TestCase):
+    def setUp(self):
+        self.temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temporary.cleanup)
+        self.root = Path(self.temporary.name)
+        self.assets = self.root / "assets"
+        (self.assets / "nested/empty").mkdir(parents=True)
+        (self.assets / "a.txt").write_bytes(b"original a")
+        (self.assets / "nested/b.pt").write_bytes(b"formal fixture bytes")
+        self.protection = self.root / "protection"
+
+    def capture(self, **extra):
+        return integrity.capture_protection(self.protection, {
+            "assets": integrity.ProtectionRoot(self.assets, "fixed"), **extra,
+        })
+
+    def records(self):
+        (self.root / "session.json").write_text('{"used": 0}')
+        (self.root / "events.jsonl").write_text('{"seq": 0}')
+        return {
+            "budget": integrity.ProtectionRoot(self.root / "session.json", "records"),
+            "events": integrity.ProtectionRoot(self.root / "events.jsonl", "records"),
+            "final": integrity.ProtectionRoot(self.root / "final_result.json", "records"),
+        }
+
+    def values(self):
+        return (json.loads((self.root / "session.json").read_text())["used"],
+                json.loads((self.root / "events.jsonl").read_text())["seq"])
+
+    def test_restore_content_empty_directories_types_and_extra_nodes(self):
+        self.capture()
+        (self.assets / "a.txt").unlink()
+        (self.assets / "a.txt").mkdir()
+        shutil.rmtree(self.assets / "nested")
+        (self.assets / "nested").write_bytes(b"wrong type")
+        (self.assets / "extra/deep").mkdir(parents=True)
+        (self.assets / "extra/deep/new").write_text("rogue")
+        observed = integrity.check_only(self.protection)
+        self.assertIn("assets/nested/empty", observed.changed_paths)
+        self.assertTrue((self.assets / "nested").is_file(), "check_only must not repair")
+        restored = integrity.check_and_restore(self.protection)
+        self.assertEqual(restored.changed_paths, restored.restored_paths)
+        self.assertFalse(restored.passed, "repair must retain original failure evidence")
+        self.assertEqual((self.assets / "a.txt").read_bytes(), b"original a")
+        self.assertEqual((self.assets / "nested/b.pt").read_bytes(), b"formal fixture bytes")
+        self.assertTrue((self.assets / "nested/empty").is_dir())
+        self.assertFalse((self.assets / "extra").exists())
+        self.assertTrue(integrity.check_only(self.protection).passed)
+
+    def test_backups_are_independent_deduplicated_and_include_pt(self):
+        (self.assets / "same.txt").write_bytes(b"original a")
+        manifest = self.capture()
+        entries = manifest["roots"]["assets"]["entries"]
+        self.assertEqual(entries["a.txt"]["backup"], entries["same.txt"]["backup"])
+        backup = self.protection / entries["a.txt"]["backup"]
+        self.assertNotEqual(backup.stat().st_ino, (self.assets / "a.txt").stat().st_ino)
+        self.assertEqual(backup.stat().st_nlink, 1)
+        self.assertIn("nested/b.pt", entries)
+        (self.assets / "a.txt").write_bytes(b"updated")
+        self.assertEqual(backup.read_bytes(), b"original a")
+        integrity.check_and_restore(self.protection)
+        self.assertEqual((self.assets / "a.txt").read_bytes(), b"original a")
