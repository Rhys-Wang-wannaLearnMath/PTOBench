+    def test_ancestor_outside_protected_root_is_not_repaired_or_followed(self):
+        holder = self.root / "holder"
+        holder.mkdir()
+        self.assets.rename(holder / "assets")
+        integrity.capture_protection(self.protection, {
+            "assets": integrity.ProtectionRoot(holder / "assets", "fixed"),
+        })
+        holder.rename(self.root / "old_holder")
+        outside = self.root / "outside"
+        (outside / "assets").mkdir(parents=True)
+        sentinel = outside / "assets/a.txt"
+        sentinel.write_text("external")
+        holder.symlink_to(outside, target_is_directory=True)
+        with self.assertRaises(integrity.InfrastructureError) as failure:
+            integrity.check_and_restore(self.protection)
+        self.assertEqual(failure.exception.error_code, "infrastructure_error")
+        self.assertEqual(failure.exception.report.unrecoverable_paths, ["assets"])
+        self.assertEqual(sentinel.read_text(), "external")
+        self.assertTrue(holder.is_symlink(), "cannot modify an unprotected ancestor")
