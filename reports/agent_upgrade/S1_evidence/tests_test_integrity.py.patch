+    def test_root_file_and_inner_links_never_touch_external_sentinel(self):
+        self.capture()
+        outside = self.root / "outside"
+        (outside / "nested").mkdir(parents=True)
+        sentinel = outside / "nested/b.pt"
+        sentinel.write_bytes(b"external sentinel")
+        for location in ("root", "directory", "file", "extra"):
+            with self.subTest(location=location):
+                if location == "root":
+                    shutil.rmtree(self.assets)
+                    self.assets.symlink_to(outside, target_is_directory=True)
+                elif location == "directory":
+                    shutil.rmtree(self.assets / "nested")
+                    (self.assets / "nested").symlink_to(outside / "nested", target_is_directory=True)
+                elif location == "file":
+                    (self.assets / "nested/b.pt").unlink()
+                    (self.assets / "nested/b.pt").symlink_to(sentinel)
+                else:
+                    (self.assets / "extra").symlink_to(outside, target_is_directory=True)
+                self.assertFalse(integrity.check_only(self.protection).passed)
+                integrity.check_and_restore(self.protection)
+                self.assertEqual(sentinel.read_bytes(), b"external sentinel")
+                self.assertTrue(integrity.check_only(self.protection).passed)
+                self.assertFalse(self.assets.is_symlink())
