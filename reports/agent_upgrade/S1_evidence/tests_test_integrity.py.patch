+    def test_process_crash_at_every_commit_boundary_recovers_consistent_records(self):
+        context = multiprocessing.get_context("fork")
+        for point in ("before_backup", "after_backup", "before_manifest", "after_manifest",
+                      "after_first_record", "after_last_record"):
+            with self.subTest(point=point), tempfile.TemporaryDirectory() as temporary:
+                root = Path(temporary)
+                (root / "budget").write_text('{"used":0}')
+                (root / "events").write_text('{"seq":0}')
+                protection = root / "protection"
+                integrity.capture_protection(protection, {
+                    "budget": integrity.ProtectionRoot(root / "budget", "records"),
+                    "events": integrity.ProtectionRoot(root / "events", "records"),
+                })
+                process = context.Process(target=_crash_commit_worker, args=(str(protection), point))
+                process.start()
+                process.join(5)
+                if process.is_alive():
+                    process.kill()
+                    process.join()
+                    self.fail("interrupted commit left its lock held")
+                self.assertEqual(process.exitcode, 23)
+                before_recovery = (
+                    json.loads((root / "budget").read_text())["used"],
+                    json.loads((root / "events").read_text())["seq"],
+                )
+                if point == "after_first_record":
+                    self.assertEqual(json.loads((root / "budget").read_text())["used"], 1)
+                    self.assertEqual(json.loads((root / "events").read_text())["seq"], 0)
+                integrity.check_and_restore(protection, "records")
+                expected = 0 if point in {"before_backup", "after_backup", "before_manifest"} else 1
+                self.assertEqual(json.loads((root / "budget").read_text())["used"], expected)
+                self.assertEqual(json.loads((root / "events").read_text())["seq"], expected)
+                self.assertTrue(integrity.check_only(protection).passed)
+                print(f"commit crash boundary={point}, exit=23, before={before_recovery}, "
+                      f"recovered=({expected}, {expected})", flush=True)
+                process.close()
+
+    def test_concurrent_process_commits_are_serialized(self):
+        self.capture(**self.records())
+        context = multiprocessing.get_context("fork")
+        ready = context.Event()
+        processes = [context.Process(target=_commit_worker, args=(str(self.protection), value, ready))
+                     for value in (41, 73)]
+        for process in processes:
+            process.start()
+        ready.set()
+        for process in processes:
+            process.join(5)
+            if process.is_alive():
+                process.kill()
+                process.join()
+                self.fail("concurrent commit deadlocked")
+            self.assertEqual(process.exitcode, 0)
+            process.close()
+        used, sequence = self.values()
+        self.assertIn(used, {41, 73})
+        self.assertEqual(used, sequence)
+        self.assertTrue(integrity.check_only(self.protection).passed)
+
+    def test_register_new_root_cannot_replace_existing_authority(self):
+        self.capture()
+        snapshot = self.root / "snapshot"
+        snapshot.mkdir()
+        (snapshot / "candidate.py").write_text("snapshot")
+        (snapshot / "candidate.py").chmod(0o444)
+        roots = {"snapshot": integrity.ProtectionRoot(snapshot, "snapshots", readonly=True)}
+        integrity.register_roots(self.protection, roots)
+        with self.assertRaises(integrity.InfrastructureError):
+            integrity.register_roots(self.protection, roots)
+        (snapshot / "candidate.py").chmod(0o644)
+        (snapshot / "candidate.py").write_text("modified")
+        integrity.check_and_restore(self.protection, "snapshots")
+        self.assertEqual((snapshot / "candidate.py").read_text(), "snapshot")
+        self.assertEqual((snapshot / "candidate.py").stat().st_mode & 0o777, 0o444)
