# Pi provider for this mode, shared by the main Agent and all Task stages.
# Provider configuration ID used by Pi; the endpoint below selects the service.
LLM_PROVIDER=provider-default
LLM_BASE_URL=https://slb-v1.api.fan/v1
LLM_API=openai-responses
LLM_MODEL=glm-5.3-flash
LLM_REASONING=max
# Set a key here, or leave blank to use PYPTO_PROVIDER_API_KEY / legacy auth.json.
LLM_API_KEY=
