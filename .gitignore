# Session and compiler output. These are reproducible and must not enter a
# standalone PTOBench clone or the parent pypto-lib repository.
.ptobench/*
build_output/
runs/
snapshots/
results/
reports/agent_upgrade/full_v02/

# Protected Case assets remain visible in the repository.  Fixture tensors are
# reproducible from each Case's fixture_builder.py and are the only sealed
# artifacts excluded here because they dominate repository size.
sealed_assets/**/*.pt

# Local Python caches and editor state.
**/__pycache__/
**/*.py[cod]
.venv/
.pytest_cache/
formal_sealed_assets/
formal_20/
performance_tuning_smoke/
jev_explore/

# Mode-local provider credentials; keep only .env.example in version control.
modes/*/.env
