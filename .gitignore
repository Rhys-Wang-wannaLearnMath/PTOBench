# Session and compiler output. These are reproducible and must not enter a
# standalone PTOBench clone or the parent pypto-lib repository.
.ptobench/*
build_output/
runs/
snapshots/
results/
reports/agent_upgrade/full_v02/

# Protected Case assets remain visible in the repository.  Fixture tensors are
# reproducible from each Case's fixture_builder.py and are the only sealed
# artifacts excluded here because they dominate repository size.
sealed_assets/**/*.pt

# Local Python caches and editor state.
**/__pycache__/
**/*.py[cod]
.venv/
.pytest_cache/
formal_sealed_assets/
formal_20/
performance_tuning_smoke/
jev_explore/
.codex
.ruff_cache
.ptobench
.agents
# Keep project skills versionable without exposing other local agent state.
!.agents/
.agents/*
!.agents/skills/
!.agents/skills/**
.aws
/升级/
archeved
lightweight_e2e
manual_runs
.superpowers
reports

# Mode-local provider credentials; keep only .env.example in version control.
modes/*/.env
pto_wiki/pto_wiki_pipeline/.env
# Local Codex workflow scratch space; reviewed provenance is stored separately.
pto_wiki/pto_wiki_pipeline/.work/
# Local-only profile-validation suite; retain it in this checkout for Bench runs.
/cases/profile_validation/
/sealed_assets/profile_validation/
